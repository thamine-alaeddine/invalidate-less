{% extends 'base.html.twig' %}

{% block page_type %}article{% endblock %}

{% block title %}{{ article.title }}{% endblock %}

{% block body %}
    <article>
        <h1>{{ article.title }}</h1>
        {{ include('_meta.html.twig') }}
        {% for paragraph in article.body|split("\n\n") %}
            <p>{{ paragraph }}</p>
        {% endfor %}
    </article>
    <aside>
        <h2>More in {{ article.category.name }}</h2>
        {{ include('_article_list.html.twig', {articles: related}) }}
    </aside>
{% endblock %}
