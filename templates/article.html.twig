{% extends 'base.html.twig' %}

{% block title %}{{ article.title }}{% endblock %}

{% block body %}
    <article>
        <h1>{{ article.title }}</h1>
        <p>
            <small>
                {{ article.publishedAt|date('Y-m-d H:i') }}
                · <a href="{{ path('category', {slug: article.category.slug}) }}">{{ article.category.name }}</a>
                · <a href="{{ path('author', {slug: article.author.slug}) }}">{{ article.author.name }}</a>
            </small>
        </p>
        {% for paragraph in article.body|split("\n\n") %}
            <p>{{ paragraph }}</p>
        {% endfor %}
    </article>
    <aside>
        <h2>More in {{ article.category.name }}</h2>
        {{ include('_article_list.html.twig', {articles: related|filter(a => a.id != article.id)|slice(0, 5)}) }}
    </aside>
{% endblock %}
