{
    "name": "invalidate-less/app",
    "description": "Benchmark: full cache purge vs tag-based invalidation with Symfony, Varnish and CloudFront",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "doctrine/doctrine-bundle": "^2.19",
        "doctrine/orm": "^3.7",
        "friendsofsymfony/http-cache-bundle": "^3.4",
        "guzzlehttp/promises": "^3.1",
        "nyholm/psr7": "^1.8",
        "php-http/httplug": "^2.4",
        "symfony/clock": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/twig-bundle": "^7.4",
        "symfony/yaml": "7.4.*"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    }
}
