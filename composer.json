{
    "name": "invalidate-less/app",
    "description": "Benchmark: full cache purge vs tag-based invalidation with Symfony, Varnish and CloudFront",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    }
}
