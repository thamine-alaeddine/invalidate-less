# Committed defaults for the demo. Override locally in .env.local (not committed).
APP_ENV=dev
APP_SECRET=change-me-in-env-local
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
# Invalidation strategy on article update: "full" (A, ban everything) or "tags" (B, xkey purge).
INVALIDATION_STRATEGY=full
